+
+    def _cobalt_openssl_library_files(self):
+        def library_file(dependency, info):
+            name, = info.libs
+            if is_msvc(self):
+                filenames = (f"{name}.lib",)
+            elif not dependency.options.shared or self.settings.os == "AIX":
+                filenames = (f"lib{name}.a",)
+            elif self.settings.os == "Windows":
+                filenames = (f"lib{name}.dll.a",)
+            elif is_apple_os(self):
+                filenames = (f"lib{name}.dylib",)
+            else:
+                filenames = (f"lib{name}.so",)
+            for directory in info.libdirs:
+                for filename in filenames:
+                    candidate = Path(directory) / filename
+                    if candidate.is_file():
+                        return candidate
+            raise ConanException(f"Library {name} missing from {dependency.ref}: {info.libdirs}")
+
+        openssl = self.dependencies["openssl"]
+        ssl = openssl.cpp_info.components["ssl"]
+        crypto = openssl.cpp_info.components["crypto"]
+        libraries = {"ssl": library_file(openssl, ssl), "crypto": library_file(openssl, crypto)}
+        if "zlib::zlib" in crypto.requires:
+            zlib = self.dependencies["zlib"]
+            libraries["zlib"] = library_file(zlib, zlib.cpp_info.aggregated_components())
+        return libraries
+
+    def _generate_cobalt_openssl_jam(self):
+        openssl = self.dependencies["openssl"]
+        ssl = openssl.cpp_info.components["ssl"]
+        crypto = openssl.cpp_info.components["crypto"]
+        includes = next((Path(path) for path in ssl.includedirs
+                         if (Path(path) / "openssl" / "ssl.h").is_file()), None)
+        if includes is None:
+            raise ConanException(f"OpenSSL headers missing from {openssl.ref}")
+        libraries = self._cobalt_openssl_library_files()
+
+        system_libraries = dict.fromkeys(ssl.system_libs + crypto.system_libs)
+        targets = {}
+        crypto_requires = []
+        for index, library in enumerate(system_libraries):
+            target = f"forge_cobalt_openssl_system_{index}"
+            targets[target] = f": : <name>{library}"
+            crypto_requires.append(f"<library>{target}")
+        if "zlib" in libraries:
+            zlib_file = libraries["zlib"].as_posix()
+            targets["forge_cobalt_openssl_zlib"] = f': : <file>"{zlib_file}"'
+            crypto_requires.append("<library>forge_cobalt_openssl_zlib")
+
+        crypto_file = libraries["crypto"].as_posix()
+        ssl_file = libraries["ssl"].as_posix()
+        targets["forge_cobalt_openssl_crypto"] = (
+            f': : <file>"{crypto_file}" : : {" ".join(crypto_requires)}'
+        )
+        targets["forge_cobalt_openssl_ssl"] = (
+            f': : <file>"{ssl_file}" : : <include>"{includes.as_posix()}" <library>forge_cobalt_openssl_crypto'
+        )
+        contents = [f"lib {name} {definition} ;" for name, definition in targets.items()]
+        contents.append(f"explicit {' '.join(targets)} ;")
+        save(self, str(self._cobalt_openssl_jam), "\n".join(contents) + "\n")
 
