+    def _remove_cobalt_dependency_copies(self):
+        # B2 install follows <library> edges and stages explicit prebuilt targets.
+        libdir = Path(self.package_folder) / "lib"
+        copies = []
+        for original in self._cobalt_openssl_library_files().values():
+            candidate = libdir / original.name
+            if not candidate.exists() and not candidate.is_symlink():
+                continue
+            if (candidate.is_symlink() or not candidate.is_file()
+                    or not files_equal(candidate, original, shallow=False)):
+                raise ConanException(f"Unexpected Boost package file {candidate}; expected a copy of {original}")
+            copies.append(candidate)
+        for candidate in copies:
+            candidate.unlink()
+
     def package(self):
